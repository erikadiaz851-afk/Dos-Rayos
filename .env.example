# =====================================================
#  DOS RAYOS — Variables de entorno
#  Copia este archivo como .env y rellena tus datos
# =====================================================

PORT=3000
NODE_ENV=development

# --- BASE DE DATOS (Supabase) ----------------------
# Supabase → Settings → Database → URI
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.XXXX.supabase.co:5432/postgres

# --- IA: ANTHROPIC CLAUDE -------------------------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX

# --- META (Instagram + Facebook) ------------------
# developers.facebook.com
META_APP_ID=TU_META_APP_ID
META_APP_SECRET=TU_META_APP_SECRET
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxx
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841xxxxxxxxx
FACEBOOK_PAGE_ID=TU_FACEBOOK_PAGE_ID

# --- TIKTOK ---------------------------------------
# developers.tiktok.com
TIKTOK_CLIENT_KEY=TU_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=TU_TIKTOK_CLIENT_SECRET
TIKTOK_ACCESS_TOKEN=SE_GENERA_CON_OAUTH

# --- YOUTUBE --------------------------------------
# console.cloud.google.com → YouTube Data API v3
YOUTUBE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-XXXXXXXXXX
YOUTUBE_REFRESH_TOKEN=SE_GENERA_CON_OAUTH
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx

# --- SPOTIFY --------------------------------------
# developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=TU_SPOTIFY_CLIENT_ID
SPOTIFY_CLIENT_SECRET=TU_SPOTIFY_CLIENT_SECRET
SPOTIFY_REFRESH_TOKEN=SE_GENERA_CON_OAUTH

# --- TWITTER / X ----------------------------------
# developer.twitter.com/portal
TWITTER_BEARER_TOKEN=TU_TWITTER_BEARER_TOKEN
TWITTER_ACCESS_TOKEN=TU_ACCESS_TOKEN
TWITTER_ACCESS_SECRET=TU_ACCESS_SECRET
TWITTER_API_KEY=TU_API_KEY
TWITTER_API_SECRET=TU_API_SECRET

# --- DEEZER ---------------------------------------
# developers.deezer.com/myapps
DEEZER_APP_ID=TU_DEEZER_APP_ID
DEEZER_SECRET_KEY=TU_DEEZER_SECRET
DEEZER_ARTIST_ID=TU_DEEZER_ARTIST_ID

# --- APPLE MUSIC (opcional) -----------------------
APPLE_TEAM_ID=TU_APPLE_TEAM_ID
APPLE_KEY_ID=TU_APPLE_KEY_ID
APPLE_PRIVATE_KEY_PATH=./config/apple_private_key.p8

# --- ARTISTA --------------------------------------
ARTIST_NAME=Dos Rayos
TWITTER_USERNAME=dosrayos

# --- SINCRONIZACIÓN AUTOMÁTICA --------------------
SYNC_INTERVAL_HOURS=6

# --- FRONTEND (para CORS) -------------------------
FRONTEND_URL=http://localhost:5173
